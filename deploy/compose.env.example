# Copy to ./.env on the deploy host (`cp deploy/compose.env.example .env`), fill the blanks,
# then `chmod 600 .env`. docker compose reads this file twice: it substitutes the ${...}
# values into docker-compose.yml, and env_file hands every line to the PHP containers, so
# Laravel picks these up as real environment variables and the host needs no backend/.env.

# Public address: either a hostname whose DNS already points at the VM, or the VM's bare public IP.
# A hostname gets a real Let's Encrypt certificate; an IP cannot (ACME does not issue for addresses),
# so Caddy serves it from its own CA and every device must trust
# /data/caddy/pki/authorities/local/root.crt before the PWA will install.
CMS_DOMAIN=cms.example.edu.pk

# Written out in full rather than built from CMS_DOMAIN: compose does not expand variables
# inside an env_file, and a half-resolved APP_URL surfaces later as broken redirects.
APP_URL=https://cms.example.edu.pk

# Generate once: docker compose run --rm app php artisan key:generate --show
APP_KEY=
APP_NAME="Nation Campus"
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Karachi

# nginx inside the app container, so the container itself is not published.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=cms
DB_USERNAME=cms
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Only Caddy can reach the app container, and it is the one writing X-Forwarded-For, so the
# Audit Log can trust it. If you ever publish the app port directly, list Caddy's CIDR instead
# — "*" would then let a visitor choose their own recorded address.
TRUSTED_PROXIES=*

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database
LOG_CHANNEL=stack
LOG_LEVEL=warning

# Nothing leaves the server until an aggregator account exists. Outbound email and SMS are
# deliberately inert here: family alerts are in-app messages.
MAIL_MAILER=log
SMS_DRIVER=log

# One-time container bootstrap switches, both off by default so a deploy is never a surprise.
# CMS_MIGRATE=1 runs `migrate --force` on start; CMS_CACHE_CONFIG=1 caches config/routes/views.
# CMS_MIGRATE=1
# CMS_CACHE_CONFIG=1
